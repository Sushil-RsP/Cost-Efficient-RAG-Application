# ====================================================================
# Cost-Efficient RAG Application Configuration
# ====================================================================

# Document Chunking Configuration
# Sensible defaults: 800 characters with 120 character overlap
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# Embedding Model Configuration (sentence-transformers / HuggingFace)
# Model dimensionality: 384 dimensions
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Generation LLM Configuration
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=your_gemini_api_key_here

# HTTP Service Configuration
PORT=8000
ENVIRONMENT=development
